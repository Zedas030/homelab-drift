# Homelab-Drift secrets
# Lives at /etc/homelab-drift/.env on the controller.
# Permissions: owner homelab-drift, chmod 600 (install.sh takes care of it). Edit with: sudo nano /etc/homelab-drift/.env
# Nothing needs to be restarted after a change; the next scan reads the file again.

# Home Assistant long-lived access token (Profile -> Security -> Long-lived access tokens -> Create token).
# Used for notifications (notify.*) and the status sensor. Best create a dedicated token just for Homelab-Drift.
HA_TOKEN=

# Optional, only for a host with type: fritzbox in config.yaml.
# A dedicated FRITZ!Box user with the "FRITZ!Box settings" permission is enough (System -> FRITZ!Box users).
FRITZ_USER=
FRITZ_PASSWORD=
